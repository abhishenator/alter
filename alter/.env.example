# ALTER Environment Configuration
# Copy this to .env and fill in your values

# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Meta-loop LLM (default: gpt-4)
META_LOOP_MODEL=gpt-4
META_LOOP_TEMPERATURE=0.7

# Sub-agent LLM (default: claude-3-5-sonnet-20241022)
AGENT_MODEL=claude-3-5-sonnet-20241022
AGENT_TEMPERATURE=0.7

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite:///data/user_data/alter.db

# User Configuration
USER_CONSTITUTION_PATH=data/user_data/my_constitution.yaml
USER_DATA_DIR=data/user_data

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/user_data/alter.log

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Feature Flags
ENABLE_CALENDAR_INTEGRATION=false
ENABLE_HEALTH_INTEGRATION=false
ENABLE_BROWSER_INTEGRATION=false
ENABLE_SCREEN_TIME_INTEGRATION=false

# Google Calendar (if enabled)
GOOGLE_CALENDAR_CREDENTIALS_PATH=data/user_data/google_credentials.json

# OpenClaw Integration (if available)
OPENCLAW_ENABLED=false
OPENCLAW_PATH=/path/to/openclaw
